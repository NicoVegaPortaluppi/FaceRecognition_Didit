# Copiar a company_mock/.env y ajustar.

LOG_LEVEL=INFO

# API de verificación (tiene que coincidir con API_KEY de verification_api/.env)
VERIFICATION_API_URL=http://localhost:8000
VERIFICATION_API_KEY=cambiar-esta-api-key

# Secreto para validar la firma de los webhooks
# (tiene que coincidir con WEBHOOK_SECRET de verification_api/.env)
WEBHOOK_SECRET=cambiar-este-secreto
WEBHOOK_TOLERANCE_SECONDS=300

HTTP_TIMEOUT_SECONDS=30
