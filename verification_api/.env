# Copiar a verification_api/.env y ajustar.

LOG_LEVEL=INFO

# URL pública con la que se arman los links para el cliente.
# Para probar desde el celular: la URL HTTPS del túnel (cloudflared o ngrok).
PUBLIC_BASE_URL=https://bless-trackback-photos-smithsonian.trycloudflare.com

# Clave que el sistema de la empresa envía en el header X-API-Key.
API_KEY=cambiar-esta-api-key

# Webhook del sistema de la empresa y secreto para firmarlo (HMAC-SHA256).
WEBHOOK_URL=http://localhost:8001/webhooks/verification
WEBHOOK_SECRET=cambiar-este-secreto
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3

# Sesión de verificación
LINK_EXPIRATION_MINUTES=1440
RECORDING_SECONDS=5

# Límites de archivos (MB)
MAX_IMAGE_MB=5
MAX_VIDEO_MB=30

# Almacenamiento local (rutas relativas a verification_api/)
STORAGE_DIR=storage
DATABASE_PATH=data/verifications.db

# Motor de verificación:
#   stub  -> local: el cliente graba en nuestra página (análisis pendiente de implementar)
#   didit -> alojado: el cliente se verifica en la página de Didit (requiere las variables DIDIT_*)
VERIFICATION_PROVIDER=didit

# --- Didit (https://business.didit.me) ---
# API key de la aplicación (sandbox o live). No compartir ni subir al repositorio.
#DIDIT_API_KEY=sk_test_FHMcQZ78GrV3yACY7YwyZrzAV82_SEYIfeJIJNbbVg8
DIDIT_API_KEY=sk_live_zdqbcZ_XyBjJ0bVnL79VLOQ7sewTE3_-kiro-UAzNEA
# ID del workflow configurado en la consola (liveness activa + face match).
#DIDIT_WORKFLOW_ID=f099b2f7-242a-482a-a64b-a56a1f2bbcd1
# ID del workflow configurado en la consola (liveness activa + face match + 3D live).
# DIDIT_WORKFLOW_ID=3375317e-f77b-48cf-8bfc-431357183011
# ID del workflow configurado en la consola (liveness pasiva + face match + 3D live).
#DIDIT_WORKFLOW_ID=4081507c-7d7a-4fce-84fc-d6cf2514852c
# # ID del workflow configurado en la consola (kyc bundle).
DIDIT_WORKFLOW_ID=e142ab33-dae6-46d9-9331-40dc041572a6
# Qué hace el workflow (tiene que coincidir con DIDIT_WORKFLOW_ID):
#   biometric -> sólo prueba de vida + face match contra la foto de la CI que cargó el
#                vendedor (se manda como portrait_image).
#   kyc       -> el cliente escanea su cédula en la sesión (lectura del documento,
#                prueba de vida y face match contra la cédula). Se manda el número de CI
#                que cargó el vendedor para que Didit lo compare con el de la cédula, y
#                no se hace la verificación server-to-server (DIDIT_DOCUMENT_CHECK).
DIDIT_WORKFLOW_MODE=kyc
# Sólo en modo kyc: país esperado de la cédula (ISO alfa-3, por ejemplo PRY). Vacío: no
# se controla. En sandbox Didit devuelve documentos de USA: dejarlo vacío para probar.
DIDIT_EXPECTED_ID_COUNTRY=
# Secreto del destino de webhook configurado en Didit (secret_shared_key).
DIDIT_WEBHOOK_SECRET=dV9OQsWmq60m_6uiMNyQmath78d4vR1cTWICyVfaX1I
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_LANGUAGE=es
# Descargar el video y la selfie de Didit al recibir la decisión.
DIDIT_DOWNLOAD_MEDIA=true

# Verificación del documento (server-to-server, sólo en modo biometric): al crear la
# verificación, las fotos
# de la CI (frente y dorso) se mandan a Didit para que evalúe si es auténtica.
# Corre en segundo plano y no cambia el estado final: se informa en "document".
# Requiere DIDIT_API_KEY. En sandbox, Didit devuelve datos ficticios.
DIDIT_DOCUMENT_CHECK=true
